{
  "name": "oddsfox-logic-explorer",
  "private": true,
  "version": "0.13.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:api": "python ../scripts/export_openapi.py --output openapi.json && openapi-typescript openapi.json -o src/generated/api-schema.ts",
    "check:api": "npm run generate:api && node scripts/assert-generated-clean.mjs web/openapi.json web/src/generated/api-schema.ts",
    "build": "tsc -b && vite build",
    "check-generated-assets": "node scripts/check-generated-assets.mjs",
    "check:packaged-assets-clean": "node scripts/assert-generated-clean.mjs oddsfox_graph/static/explorer",
    "lint": "eslint .",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@sigma/edge-curve": "^3.1.0",
    "graphology": "^0.26.0",
    "graphology-layout": "^0.6.1",
    "graphology-layout-forceatlas2": "^0.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sigma": "^3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "graphology-types": "0.24.8",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  }
}
