{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OddsFox v0.9 automated discovery release fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "source_sha256", "files", "trees"],
  "properties": {
    "schema_version": {"const": "discovery-release-fixture-v5"},
    "package_version": {"const": "0.9.0"},
    "source_sha256": {
      "const": "790bd1595b379472ad65ba0073105b4eb630974d04e7b44d58c8a4929f274aa2"
    },
    "files": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
      "required": [
        "input.parquet",
        "performance_report.json",
        "compute_profile.json",
        "primary_model_manifest.json",
        "verifier_model_manifest.json",
        "automation_profile.json",
        "qualification_report.json",
        "qualification_cases.parquet",
        "expected_artifact_hashes.json",
        "baselines/5000/build_manifest.json",
        "baselines/20000/build_manifest.json"
      ],
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "trees": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
      "required": ["cache", "baselines/5000", "baselines/20000"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "file_count"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "file_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
