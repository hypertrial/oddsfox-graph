{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OddsFox v0.12 deterministic fast-mode release fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_version", "source_sha256", "files", "trees"],
  "properties": {
    "schema_version": {"const": "discovery-release-fixture-v7"},
    "package_version": {"const": "0.12.0"},
    "source_sha256": {
      "const": "790bd1595b379472ad65ba0073105b4eb630974d04e7b44d58c8a4929f274aa2"
    },
    "files": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
      "required": [
        "input.parquet",
        "performance_report.json",
        "expected_artifact_hashes.json",
        "baselines/fast/build_manifest.json",
        "baselines/fast/viewer_manifest.json",
        "baselines/fast/coverage_summary.json"
      ],
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "trees": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
      "required": ["baselines/fast"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "file_count"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "file_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
